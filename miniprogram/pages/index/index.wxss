/* pages/index/index.wxss */

.status-card {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #ffffff;
}

.status-card .card-title {
  color: #ffffff;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-online {
  background-color: #52C41A;
}

.status-offline {
  background-color: #FF4D4F;
}

.temperature {
  font-size: 48rpx;
  font-weight: 600;
}

.humidity {
  font-size: 24rpx;
  opacity: 0.8;
}

.last-update {
  font-size: 24rpx;
  opacity: 0.7;
}

.quick-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666666;
}

.view-all {
  font-size: 24rpx;
  color: #4A90E2;
}

.device-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #4A90E2;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.calendar-list {
  display: flex;
  flex-direction: column;
}

.calendar-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.calendar-item:last-child {
  border-bottom: none;
}

.calendar-time {
  font-size: 24rpx;
  color: #4A90E2;
  width: 120rpx;
}

.calendar-title {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  color: #999999;
  font-size: 28rpx;
}

/* pages/calendar/calendar.wxss */

.date-picker {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #F0F5FF;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.date-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.date-text {
  font-size: 32rpx;
  color: #333333;
}

.add-btn {
  font-size: 28rpx;
  color: #4A90E2;
  padding: 10rpx 20rpx;
  background-color: #F0F5FF;
  border-radius: 8rpx;
}

.calendar-list {
  margin-top: 20rpx;
}

.calendar-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
}

.calendar-time-col {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid #E8E8E8;
  margin-right: 20rpx;
}

.calendar-time {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A90E2;
}

.calendar-date {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.calendar-content {
  flex: 1;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.calendar-desc {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
}

.calendar-reminder {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.reminder-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.reminder-text {
  font-size: 22rpx;
  color: #52C41A;
}

.calendar-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
}

.action-btn.delete {
  background-color: #FF4D4F;
  color: #ffffff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 80%;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 10rpx;
}

.modal-body {
  padding: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #F0F0F0;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.btn-cancel {
  color: #666666;
  background-color: #F5F5F5;
}

.btn-confirm {
  color: #ffffff;
  background-color: #4A90E2;
}

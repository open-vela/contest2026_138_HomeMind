/* pages/devices/devices.wxss */

.add-btn {
  font-size: 28rpx;
  color: #4A90E2;
  padding: 10rpx 20rpx;
  background-color: #F0F5FF;
  border-radius: 8rpx;
}

.device-list {
  margin-top: 20rpx;
}

.device-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
}

.device-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.device-location {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.device-status {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.online {
  background-color: #52C41A;
}

.status-dot.offline {
  background-color: #FF4D4F;
}

.status-text {
  font-size: 24rpx;
  color: #666666;
}

.device-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  text-align: center;
}

.action-btn.toggle {
  background-color: #4A90E2;
  color: #ffffff;
}

.action-btn.delete {
  background-color: #FF4D4F;
  color: #ffffff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

/* 米家控制卡片 */
.mihome-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.mihome-device {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.mihome-state {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.mihome-state.on {
  color: #52C41A;
}

.mihome-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn.mihome-on {
  background-color: #52C41A;
  color: #ffffff;
}

.action-btn.mihome-off {
  background-color: #8C8C8C;
  color: #ffffff;
}

.action-btn.mihome-query {
  background-color: #F0F5FF;
  color: #4A90E2;
}

.action-btn.disabled {
  opacity: 0.5;
}

.mihome-result {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.mihome-result.ok {
  color: #52C41A;
}

.mihome-result.bad {
  color: #FF4D4F;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 80%;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 10rpx;
}

.modal-body {
  padding: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #F0F0F0;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.btn-cancel {
  color: #666666;
  background-color: #F5F5F5;
}

.btn-confirm {
  color: #ffffff;
  background-color: #4A90E2;
}

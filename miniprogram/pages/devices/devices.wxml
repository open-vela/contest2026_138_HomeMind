<!-- pages/devices/devices.wxml -->
<view class="container">
  <view class="card">
    <view class="flex-row" style="justify-content: space-between;">
      <view class="card-title">我的设备</view>
      <view class="add-btn" bindtap="addDevice">+ 添加设备</view>
    </view>

    <view class="device-list" wx:if="{{devices.length > 0}}">
      <view class="device-item" wx:for="{{devices}}" wx:key="id">
        <view class="device-icon">
          <text wx:if="{{item.led_state === 'on'}}">💡</text>
          <text wx:else>📱</text>
        </view>
        <view class="device-info">
          <view class="device-name">{{item.name}}</view>
          <view class="device-location">{{item.online ? '在线' : '离线'}}</view>
        </view>
        <view class="device-status">
          <view class="status-dot {{item.online ? 'online' : 'offline'}}"></view>
          <view class="status-text">{{item.online ? '在线' : '离线'}}</view>
        </view>
        <view class="device-actions">
          <view class="action-btn toggle {{item.led_state === 'pending' ? 'disabled' : ''}}"
                bindtap="toggleDevice" data-id="{{item.id}}">
            {{item.led_state === 'on' ? '关闭' : (item.led_state === 'pending' ? '执行中' : '开启')}}
          </view>
          <view class="action-btn delete" bindtap="deleteDevice" data-id="{{item.id}}">移除</view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-icon">📱</view>
      <view class="empty-text">{{loading ? '加载中…' : '暂无设备'}}</view>
      <view class="empty-hint">{{loading ? '' : '登录后自动绑定 HomeMind 设备'}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{devices.length > 0}}">
    <view class="card-title">米家设备控制</view>

    <block wx:for="{{devices}}" wx:for-item="dev" wx:key="id">
      <!-- 自动同步实体：网关上报（含 friendly_name，如"阳台开关"） -->
      <block wx:if="{{dev.mihome_entities.length > 0}}">
        <view class="mihome-row" wx:for="{{dev.mihome_entities}}" wx:for-item="ent" wx:for-index="ei" wx:key="entity_id">
          <view class="mihome-device">
            {{ent.name}}
            <text class="mihome-state {{ent.state === 'on' ? 'on' : ''}}">（{{ent.state === 'on' ? '开' : ent.state === 'off' ? '关' : ent.state || '未知'}}）</text>
          </view>
          <view class="mihome-actions">
            <view class="action-btn mihome-on {{mihomePending[dev.id + '|' + ent.entity_id] ? 'disabled' : ''}}"
                  bindtap="mihomeAction" data-id="{{dev.id}}" data-entity="{{ent.entity_id}}" data-kind="on">开</view>
            <view class="action-btn mihome-off {{mihomePending[dev.id + '|' + ent.entity_id] ? 'disabled' : ''}}"
                  bindtap="mihomeAction" data-id="{{dev.id}}" data-entity="{{ent.entity_id}}" data-kind="off">关</view>
            <view class="action-btn mihome-query {{mihomePending[dev.id + '|' + ent.entity_id] ? 'disabled' : ''}}"
                  bindtap="mihomeAction" data-id="{{dev.id}}" data-entity="{{ent.entity_id}}" data-kind="query">查状态</view>
          </view>
          <view class="mihome-result {{mihomeResult[dev.id + '|' + ent.entity_id].ok ? 'ok' : 'bad'}}"
                wx:if="{{mihomeResult[dev.id + '|' + ent.entity_id]}}">
            {{mihomeResult[dev.id + '|' + ent.entity_id].text}}
          </view>
        </view>
      </block>

      <!-- 兜底：网关离线或旧版网关未上报实体快照时手填 -->
      <block wx:else>
        <view class="form-item">
          <view class="form-label">{{dev.name}}：网关实体快照暂不可用，手动输入实体 ID（light.*/switch.*）</view>
          <input class="form-input" placeholder="如 switch.linp_cn_xxx_on_p_2_1" value="{{mihomeManual}}" bindinput="onMihomeManualInput" />
        </view>
        <view class="mihome-row">
          <view class="mihome-actions">
            <view class="action-btn mihome-on {{mihomePending[dev.id + '|' + mihomeManual] ? 'disabled' : ''}}"
                  bindtap="mihomeAction" data-id="{{dev.id}}" data-entity="{{mihomeManual}}" data-kind="on">开</view>
            <view class="action-btn mihome-off {{mihomePending[dev.id + '|' + mihomeManual] ? 'disabled' : ''}}"
                  bindtap="mihomeAction" data-id="{{dev.id}}" data-entity="{{mihomeManual}}" data-kind="off">关</view>
            <view class="action-btn mihome-query {{mihomePending[dev.id + '|' + mihomeManual] ? 'disabled' : ''}}"
                  bindtap="mihomeAction" data-id="{{dev.id}}" data-entity="{{mihomeManual}}" data-kind="query">查状态</view>
          </view>
          <view class="mihome-result {{mihomeResult[dev.id + '|' + mihomeManual].ok ? 'ok' : 'bad'}}"
                wx:if="{{mihomeResult[dev.id + '|' + mihomeManual]}}">
            {{mihomeResult[dev.id + '|' + mihomeManual].text}}
          </view>
        </view>
      </block>
    </block>

    <view class="empty-hint" style="margin-top: 12rpx;">命令经云端 → 家庭网关 → Home Assistant 下发；"开/关"只在网关状态回读确认后才显示成功。</view>
  </view>

  <view class="modal" wx:if="{{showAddModal}}">
    <view class="modal-mask" bindtap="hideAddModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-title">绑定设备</view>
        <view class="modal-close" bindtap="hideAddModal">✕</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <view class="form-label">设备 ID</view>
          <input class="form-input" placeholder="如 esp32s3-eye" value="{{newDevice.device_id}}" bindinput="onInputChange" data-field="device_id" />
        </view>
        <view class="form-item">
          <view class="form-label">备注名</view>
          <input class="form-input" placeholder="如 客厅 HomeMind" value="{{newDevice.name}}" bindinput="onInputChange" data-field="name" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn btn-cancel" bindtap="hideAddModal">取消</view>
        <view class="btn btn-confirm" bindtap="confirmAdd">确定</view>
      </view>
    </view>
  </view>
</view>

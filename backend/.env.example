# HomeMind C1 云端环境变量模板（复制为 .env，按需填写；.env 绝不进仓库）
# ---- 微信小程序（AppSecret 仅此处/服务器环境变量，绝不进代码/聊天记录）----
WX_APPID=your-miniprogram-appid
WX_APPSECRET=your-miniprogram-appsecret

# ---- JWT 签名密钥（部署前务必生成强随机值：openssl rand -hex 32）----
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_DAYS=30

# ---- 命令 TTL（秒）----
COMMAND_TTL_SEC=30

# ---- 设备/命令 ----
DEMO_DEVICE_ID=esp32s3-eye
ALLOWED_ACTIONS=led.on,led.off,device.info,mihome.set_power,mihome.get_state

# ---- Optional gateway-side MiHome bridge (never put Xiaomi credentials in ESP32) ----
# Configure these only after installing/configuring the official Xiaomi Home
# Integration in a user-owned Home Assistant instance.
# HOMEMIND_HA_URL=http://homeassistant.local:8123
# HOMEMIND_HA_TOKEN=generate-a-long-lived-token-outside-this-repository
# HOMEMIND_MIHOME_ALLOWED_ENTITIES=light.living_room

# ---- 入口转发模式（C1.0）----
# true：云端只做入口（微信登录/转发），业务接口经家庭出站通道执行；
# 必须与家庭 JWT_SECRET 一致（云端签发的小程序 JWT，家庭 API 直接校验）。
# false：业务接口云端本地执行（旧模式/家庭副本）。
RELAY_MODE=false
RELAY_TIMEOUT=20

# ---- CORS（微信小程序无需浏览器 CORS；确有 Web 客户端时填写可信 HTTPS 源）----
CORS_ORIGINS=

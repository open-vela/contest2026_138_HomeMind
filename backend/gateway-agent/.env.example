# 家庭网关环境变量（写入 home Ubuntu 的 gateway-agent/.env，绝不进仓库）
API_HOST=hfy-ai.cloud
API_PORT=8883
MQTT_USER=gateway
MQTT_PASS=由云端 deploy.sh 生成并下发
TLS_CA_PATH=            # 自签证书 LAN 联调时填证书路径；Let's Encrypt 留空用系统 CA
DEVICE_ID=esp32s3-eye
SERIAL_PORT=/dev/ttyACM0
BAUD=115200
CMD_TTL=30
CMD_MODE=ask           # ask=经 ai_agent 自然语言；direct=直接 JSON（设备端待支持）

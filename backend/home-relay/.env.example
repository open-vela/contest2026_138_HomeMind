# 家庭出站通道 relay 部署（backend/home-relay/）
# 测试模式：连接本地 mosquitto（用户 home-relay），模拟云端入口转发闭环。
# 生产模式：RELAY_MQTT_HOST=api.hfy-ai.cloud RELAY_MQTT_PORT=8883 RELAY_TLS=true

RELAY_MQTT_HOST=127.0.0.1
RELAY_MQTT_PORT=1883
RELAY_MQTT_USER=home-relay
RELAY_MQTT_PASS=__RELAY_PASS__
RELAY_TLS=false
RELAY_API_BASE=http://127.0.0.1:8001

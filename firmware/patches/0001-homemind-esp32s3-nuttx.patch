+/*****************************************************************************
+ * Name: hm_autostart_trampoline
+ *
+ * Description:
+ *   HomeMind: sleep through the tail of bring-up, then start the AI agent.
+ *   The agent entry is stored in a static pointer so it stays valid after
+ *   board_app_initialize() has returned.
+ *
+ *****************************************************************************/
+
+#ifdef CONFIG_EXAMPLES_AI_AGENT_VELA
+extern int ai_agent_main(int argc, char *argv[]);
+
+static int hm_autostart_trampoline(int argc, char *argv[])
+{
+  static int (*entry)(int argc, char *argv[]) = ai_agent_main;
+  int cons;
+  int i;
+
+  sleep(5);
+
+  /* board_app_initialize() runs before NSH opens the console, so this
+   * task inherited garbage stdin/stdout/stderr.  Give the agent a real
+   * console or its first printf crashes the board. */
+  cons = open("/dev/console", O_RDWR);
+  if (cons >= 0)
+    {
+      for (i = 0; i < 3; i++)
+        {
+          dup2(cons, i);
+        }
+      if (cons > 2)
+        {
+          close(cons);
+        }
+    }
+
+  syslog(LOG_INFO, "hm_boot: starting ai_agent\n");
+
+  /* Do NOT call ai_agent_main() here: this trampoline has a 2 KiB stack
+   * while the agent needs its full 32 KiB (config/Wi-Fi ioctls crash with
+   * a small stack).  Spawn a properly sized task instead; it inherits the
+   * console fds dup2'ed above. */
+  if (task_create("ai_agent", CONFIG_EXAMPLES_AI_AGENT_VELA_PRIORITY,
+                  CONFIG_EXAMPLES_AI_AGENT_VELA_STACKSIZE, entry, NULL) < 0)
+    {
+      syslog(LOG_ERR, "hm_boot: ai_agent spawn failed\n");
+      return -1;
+    }
+  return OK;
+}
+#endif

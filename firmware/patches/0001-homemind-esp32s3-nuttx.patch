+/* HomeMind: internal-DMA fallback pool for Wi-Fi driver allocations.
+ *
+ * The shared kmm heap spans internal DRAM and PSRAM, but the Wi-Fi library
+ * requires internal (DMA-capable) memory for its TX buffers and rejects
+ * PSRAM pointers (esp_malloc_internal).  Once user-space allocations
+ * (e.g. mbedTLS ssl_setup) exhaust the internal DRAM free blocks, Wi-Fi
+ * TX buffers can no longer be allocated and esp_wifi_internal_tx() fails
+ * with ESP_ERR_NO_MEM while TCP segments silently never reach the radio.
+ * This static pool, placed in .dram0.bss (internal DRAM), provides
+ * guaranteed-internal memory as a fallback for those driver allocations.
+ */
+
+#define HM_WLAN_POOL_SIZE    (16 * 1024)
+#define HM_WLAN_POOL_ALIGN   8
+
+struct hm_wlan_blk_s
+{
+  size_t    size;                     /* total block size, header included */
+  uint32_t  used;                     /* 0 = free, 1 = used */
+};
+
+static uint8_t g_hm_wlan_pool[HM_WLAN_POOL_SIZE]
+              __attribute__((aligned(HM_WLAN_POOL_ALIGN)));
+
+static bool hm_wlan_pool_member(void *ptr)
+{
+  uint8_t *p = (uint8_t *)ptr;
+
+  return p >= g_hm_wlan_pool && p < g_hm_wlan_pool + HM_WLAN_POOL_SIZE;
+}
+
+static size_t hm_wlan_pool_blksize(void *ptr)
+{
+  struct hm_wlan_blk_s *blk =
+    (struct hm_wlan_blk_s *)ptr - 1;
+
+  return blk->size - sizeof(struct hm_wlan_blk_s);
+}
+
+static void *hm_wlan_pool_alloc(size_t size)
+{
+  irqstate_t flags;
+  struct hm_wlan_blk_s *blk;
+  size_t need = (size + sizeof(struct hm_wlan_blk_s) +
+                 HM_WLAN_POOL_ALIGN - 1) & ~((size_t)HM_WLAN_POOL_ALIGN - 1);
+
+  flags = enter_critical_section();
+
+  /* Lazy one-time init: the static pool starts all-zero, so the first
+   * block header must be created before the first allocation.  Doing it
+   * here (inside the critical section) keeps it race-free.
+   */
+
+  blk = (struct hm_wlan_blk_s *)g_hm_wlan_pool;
+  if (blk->size == 0)
+    {
+      blk->size = HM_WLAN_POOL_SIZE;
+      blk->used = 0;
+    }
+
+  for (blk = (struct hm_wlan_blk_s *)g_hm_wlan_pool;
+       (uint8_t *)blk < g_hm_wlan_pool + HM_WLAN_POOL_SIZE;
+       blk = (struct hm_wlan_blk_s *)((uint8_t *)blk + blk->size))
+    {
+      if (blk->size == 0)
+        {
+          /* Defensive: never loop forever with interrupts disabled */
+
+          leave_critical_section(flags);
+          return NULL;
+        }
+
+      if (blk->used || blk->size < need)
+        {
+          continue;
+        }
+
+      if (blk->size >= need + sizeof(struct hm_wlan_blk_s) +
+                       HM_WLAN_POOL_ALIGN)
+        {
+          struct hm_wlan_blk_s *next =
+            (struct hm_wlan_blk_s *)((uint8_t *)blk + need);
+
+          next->size = blk->size - need;
+          next->used = 0;
+          blk->size  = need;
+        }
+
+      blk->used = 1;
+      leave_critical_section(flags);
+      return (void *)(blk + 1);
+    }
+
+  leave_critical_section(flags);
+  return NULL;
+}
+
+static void hm_wlan_pool_free(void *ptr)
+{
+  irqstate_t flags;
+  struct hm_wlan_blk_s *blk;
+
+  if (!hm_wlan_pool_member(ptr))
+    {
+      return;
+    }
+
+  blk = (struct hm_wlan_blk_s *)ptr - 1;
+
+  flags = enter_critical_section();
+
+  blk->used = 0;
+
+  /* Coalesce adjacent free blocks */
+
+  blk = (struct hm_wlan_blk_s *)g_hm_wlan_pool;
+  while ((uint8_t *)blk < g_hm_wlan_pool + HM_WLAN_POOL_SIZE)
+    {
+      struct hm_wlan_blk_s *next =
+        (struct hm_wlan_blk_s *)((uint8_t *)blk + blk->size);
+
+      if (!blk->used &&
+          (uint8_t *)next < g_hm_wlan_pool + HM_WLAN_POOL_SIZE &&
+          !next->used)
+        {
+          blk->size += next->size;
+        }
+      else
+        {
+          blk = next;
+        }
+    }
+
+  leave_critical_section(flags);
+}
